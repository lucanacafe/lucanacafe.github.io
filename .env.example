# ── Tarayıcıya giden değerler (herkese açık, SIR DEĞİL) ─────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Sitenin yayın adresi (QR kodları bu adrese göre üretilir).
# Özel domain alınınca https://lucanacafe.com/ gibi güncelleyin.
VITE_SITE_URL=https://lucanacafe.github.io/
# Vite base yolu: lucanacafe.github.io ve özel domainde /  (proje sitesi olsaydı /repo-adi/)
VITE_BASE=/

# Web Push public key (node scripts/db.mjs push üretir)
VITE_VAPID_PUBLIC_KEY=B...

# ── Yalnızca yerel betikler (scripts/db.mjs) — ASLA commit etmeyin ─
SUPABASE_PROJECT_REF=xxxx
SUPABASE_ACCESS_TOKEN=sbp_...
# node scripts/db.mjs push tarafından doldurulur (SIR)
LUCANA_VAPID_PRIVATE_KEY=
LUCANA_PUSH_SECRET=
